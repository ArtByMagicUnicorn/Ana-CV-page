{
    "routes": [
        {
            "route": "/api/cv",
            "methods": [ "GET" ],
            "allowedRoles": [ "anonymous" ]
        },
        {
            "route": "/api/cv",
            "methods": [ "PUT" ],
            "allowedRoles": [ "cv_admin" ]
        },
        {
            "route": "/api/media/profile-image",
            "methods": [ "POST" ],
            "allowedRoles": [ "cv_admin" ]
        },
        {
            "route": "/api/media/beyond-image",
            "methods": [ "POST" ],
            "allowedRoles": [ "cv_admin" ]
        },
        {
            "route": "/admin*",
            "allowedRoles": [ "cv_admin" ]
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html"
    }
}