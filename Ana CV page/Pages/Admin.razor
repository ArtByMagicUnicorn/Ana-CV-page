@page "/admin"

@using Ana_CV_page.Models
@using Ana_CV_page.Services
@inject CvDataService CvService

<PageTitle>Ana Control Center</PageTitle>

<div class="admin-shell">

    <aside class="admin-sidebar">
        <div class="admin-brand">
            <img src="images/camelion.png"
                 alt="Ana Gheorghe logo"
                 class="admin-logo" />

            <div>
                <strong>Ana Control Center</strong>
                <span>CV management</span>
            </div>
        </div>

        <nav class="admin-nav">
            <a href="/admin#profile">Profile</a>
            <a href="/admin#experience">Experience</a>
            <a href="/admin#skills">Skills</a>
            <a href="/admin#background">Background</a>
            <a href="/admin#beyond">Beyond the Numbers</a>
            <a href="/admin#media">Media</a>
        </nav>

        <a href="/" class="admin-view-site">
            ← View public site
        </a>
    </aside>

    <main class="admin-content">

        <header class="admin-header">
            <div>
                <p class="admin-eyebrow">Dashboard</p>
                <h1>Welcome, Ana</h1>
                <p>
                    Update the content of your CV without touching the code.
                </p>
            </div>

            <div class="admin-header-actions">
                <span class="admin-form-note">
                    @saveMessage
                </span>

                <button type="button"
                        class="admin-save-button"
                        @onclick="SaveCvAsync"
                        disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save changes")
                </button>

                <a href="/.auth/logout?post_logout_redirect_uri=/"
                   class="admin-logout-link">
                    Log out
                </a>
            </div>
        </header>

        <ProfileEditor Profile="@cv.Profile" />

        <ExperienceEditor Experiences="@cv.Experiences" />

        <SkillsEditor Skills="@cv.Skills" />

        <BackgroundEditor Education="@cv.Education"
                          Languages="@cv.Languages"
                          Certifications="@cv.Certifications" />

        <BeyondTheNumbersEditor BeyondTheNumbers="@cv.BeyondTheNumbers" />

        <MediaEditor Profile="@cv.Profile"
                     BeyondTheNumbers="@cv.BeyondTheNumbers" />

    </main>

</div>

@code {
    private CvData cv = new();

    private bool isSaving;
    private string? saveMessage;

    protected override async Task OnInitializedAsync()
    {
        cv = await CvService.GetCvAsync() ?? new CvData();
    }

    private async Task SaveCvAsync()
    {
        try
        {
            isSaving = true;
            saveMessage = "Saving...";

            await CvService.SaveCvAsync(cv);

            saveMessage = "Saved ✓";
        }
        catch
        {
            saveMessage = "Could not save.";
        }
        finally
        {
            isSaving = false;
        }
    }

  
}
