@using Ana_CV_page.Models

<section id = "intro" class= "intro-video" >

    <div class="intro-video__heading">
        <p class="eyebrow">Meet Ana</p>

        <h2>
            A short introduction<span>.</span>
        </h2>

        <p>
            A few words from Ana about her background,
            what drives her and what she is looking for next.
        </p>
    </div>

    <div class="intro-video__frame">

        @{
            var videoId = GetYouTubeVideoId(Profile.IntroVideoUrl);
        }

        @if (!string.IsNullOrWhiteSpace(videoId))
        {
            <iframe src="@($"https://www.youtube-nocookie.com/embed/{videoId}")"
                    title="Ana Gheorghe intro video"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen>
            </iframe>
        }
        else
        {
            <div class="intro-video__placeholder">
                <div class="intro-video__play">
                    ▶
                </div>

                <strong>Video coming soon</strong>

                <span>
                    Ana will introduce herself here.
                </span>
            </div>
        }

    </div>

</section>

@code {
    [Parameter]
    public string? VideoUrl { get; set; }

    [Parameter]
    public string? PosterUrl { get; set; }

    [Parameter, EditorRequired]
    public Profile Profile { get; set; } = new();

    private string? GetYouTubeVideoId(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return null;

        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
            return null;

        if (uri.Host.Contains("youtu.be"))
            return uri.AbsolutePath.Trim('/');

        if (uri.Host.Contains("youtube.com") &&
            (uri.AbsolutePath.StartsWith("/shorts/") ||
             uri.AbsolutePath.StartsWith("/embed/")))
        {
            return uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries)
                                   .LastOrDefault();
        }

        if (uri.Host.Contains("youtube.com"))
        {
            foreach (var part in uri.Query.TrimStart('?').Split('&'))
            {
                var pair = part.Split('=', 2);

                if (pair.Length == 2 && pair[0] == "v")
                    return Uri.UnescapeDataString(pair[1]);
            }
        }

        return null;
    }
}