@using Ana_CV_page.Models

@inject NavigationManager Navigation

<section id="background" class="admin-section">

    <div class="admin-section-heading">
        <div>
            <span class="admin-section-number">04</span>
            <h2>Background</h2>
        </div>

        <p>
            Education, languages and certifications.
        </p>
    </div>

    <div class="background-admin">

        <div class="background-admin__group">

            <div class="background-admin__group-header">
                <div>
                    <span class="admin-section-number">EDUCATION</span>
                    <h3>Education</h3>
                </div>

                <button type="button"
                        class="admin-add-button"
                        @onclick="AddEducation">
                    + Add education
                </button>
            </div>

            @if (editingEducation is not null)
            {
                <div id="education-editor" class="background-editor">

                    <div class="background-editor__header">
                        <div>
                            <span class="admin-section-number">
                                @(isAddingEducation ? "NEW EDUCATION" : "EDIT EDUCATION")
                            </span>

                            <h3>
                                @(isAddingEducation
                                    ? "Add education"
                                    : editingEducation.Program)
                            </h3>
                        </div>

                        <button type="button"
                                class="admin-text-button"
                                @onclick="CancelEducationEdit">
                            Close
                        </button>
                    </div>

                    <div class="admin-form-grid">

                        <div class="admin-field">
                            <label>School</label>
                            <input type="text"
                                   @bind="editingEducation.School" />
                        </div>

                        <div class="admin-field">
                            <label>Program</label>
                            <input type="text"
                                   @bind="editingEducation.Program" />
                        </div>

                        <div class="admin-field">
                            <label>Start year</label>
                            <input type="number"
                                   @bind="editingEducation.StartYear" />
                        </div>

                        <div class="admin-field">
                            <label>End year</label>
                            <input type="number"
                                   @bind="editingEducation.EndYear" />
                        </div>

                    </div>

                    <div class="background-editor__actions">

                        <button type="button"
                                class="admin-secondary-button"
                                @onclick="CancelEducationEdit">
                            Cancel
                        </button>

                        <button type="button"
                                class="admin-save-button"
                                @onclick="ApplyEducation">
                            Done editing
                        </button>

                    </div>

                </div>
            }

            <div class="background-admin__list">

                @foreach (var education in Education.OrderBy(x => x.SortOrder))
                {
                    <div class="background-admin__item">

                        <div class="background-admin__item-content">
                            <strong>@education.Program</strong>
                            <span>@education.School</span>
                            <small>
                                @education.StartYear – @education.EndYear
                            </small>
                        </div>

                        <div class="background-admin__actions">

                            <div class="background-admin__move-actions">

                                <button type="button"
                                        class="highlight-button"
                                        title="Move up"
                                        disabled="@(education == Education.OrderBy(x => x.SortOrder).First())"
                                        @onclick="() => MoveEducationUp(education)">
                                    ↑
                                </button>

                                <button type="button"
                                        class="highlight-button"
                                        title="Move down"
                                        disabled="@(education == Education.OrderBy(x => x.SortOrder).Last())"
                                        @onclick="() => MoveEducationDown(education)">
                                    ↓
                                </button>

                            </div>

                            <button type="button"
                                    class="admin-text-button"
                                    @onclick="() => EditEducation(education)">
                                Edit
                            </button>

                            <button type="button"
                                    class="admin-text-button admin-text-button--danger"
                                    @onclick="() => DeleteEducation(education)">
                                Delete
                            </button>

                        </div>

                    </div>
                }

            </div>

        </div>

        <div class="background-admin__group">

            <div class="background-admin__group-header">
                <div>
                    <span class="admin-section-number">LANGUAGES</span>
                    <h3>Languages</h3>
                </div>

                <button type="button"
                        class="admin-add-button"
                        @onclick="AddLanguage">
                    + Add language
                </button>
            </div>

            @if (editingLanguage is not null)
            {
                <div id="language-editor" class="background-editor">

                    <div class="background-editor__header">
                        <div>
                            <span class="admin-section-number">
                                @(isAddingLanguage ? "NEW LANGUAGE" : "EDIT LANGUAGE")
                            </span>

                            <h3>
                                @(isAddingLanguage
                                    ? "Add language"
                                    : editingLanguage.Name)
                            </h3>
                        </div>

                        <button type="button"
                                class="admin-text-button"
                                @onclick="CancelLanguageEdit">
                            Close
                        </button>
                    </div>

                    <div class="admin-form-grid">

                        <div class="admin-field">
                            <label>Language</label>
                            <input type="text"
                                   @bind="editingLanguage.Name" />
                        </div>

                        <div class="admin-field">
                            <label>Proficiency</label>
                            <input type="text"
                                   @bind="editingLanguage.Proficiency" />
                        </div>

                    </div>

                    <div class="background-editor__actions">

                        <button type="button"
                                class="admin-secondary-button"
                                @onclick="CancelLanguageEdit">
                            Cancel
                        </button>

                        <button type="button"
                                class="admin-save-button"
                                @onclick="ApplyLanguage">
                            Apply changes
                        </button>

                    </div>

                </div>
            }

            <div class="background-admin__list">

                @foreach (var language in Languages.OrderBy(x => x.SortOrder))
                {
                    <div class="background-admin__item">

                        <div class="background-admin__item-content">
                            <strong>@language.Name</strong>
                            <span>@language.Proficiency</span>
                        </div>

                        <div class="background-admin__actions">

                            <div class="background-admin__move-actions">

                                <button type="button"
                                        class="highlight-button"
                                        title="Move up"
                                        disabled="@(language == Languages.OrderBy(x => x.SortOrder).First())"
                                        @onclick="() => MoveLanguageUp(language)">
                                    ↑
                                </button>

                                <button type="button"
                                        class="highlight-button"
                                        title="Move down"
                                        disabled="@(language == Languages.OrderBy(x => x.SortOrder).Last())"
                                        @onclick="() => MoveLanguageDown(language)">
                                    ↓
                                </button>

                            </div>

                            <button type="button"
                                    class="admin-text-button"
                                    @onclick="() => EditLanguage(language)">
                                Edit
                            </button>

                            <button type="button"
                                    class="admin-text-button admin-text-button--danger"
                                    @onclick="() => DeleteLanguage(language)">
                                Delete
                            </button>

                        </div>

                    </div>
                }

            </div>

        </div>

        <div class="background-admin__group">

            <div class="background-admin__group-header">
                <div>
                    <span class="admin-section-number">CERTIFICATIONS</span>
                    <h3>Certifications</h3>
                </div>

                <button type="button"
                        class="admin-add-button"
                        @onclick="AddCertification">
                    + Add certification
                </button>
            </div>

            @if (editingCertification is not null)
            {
                <div id="certification-editor" class="background-editor">

                    <div class="background-editor__header">
                        <div>
                            <span class="admin-section-number">
                                @(isAddingCertification ? "NEW CERTIFICATION" : "EDIT CERTIFICATION")
                            </span>

                            <h3>
                                @(isAddingCertification
                                    ? "Add certification"
                                    : editingCertification.Title)
                            </h3>
                        </div>

                        <button type="button"
                                class="admin-text-button"
                                @onclick="CancelCertificationEdit">
                            Close
                        </button>
                    </div>

                    <div class="admin-form-grid">

                        <div class="admin-field">
                            <label>Title</label>
                            <input type="text"
                                   @bind="editingCertification.Title" />
                        </div>

                        <div class="admin-field">
                            <label>Issuer</label>
                            <input type="text"
                                   @bind="editingCertification.Issuer" />
                        </div>

                        <div class="admin-field admin-field--full">
                            <label>Description</label>
                            <textarea rows="4"
                                      @bind="editingCertification.Description"></textarea>
                        </div>

                    </div>

                    <div class="background-editor__actions">

                        <button type="button"
                                class="admin-secondary-button"
                                @onclick="CancelCertificationEdit">
                            Cancel
                        </button>

                        <button type="button"
                                class="admin-save-button"
                                @onclick="ApplyCertification">
                            Apply changes
                        </button>

                    </div>

                </div>
            }

            @if (Certifications.Count == 0)
            {
                <div class="background-admin__empty">
                    No certifications added yet.
                </div>
            }
            else
            {
                <div class="background-admin__list">

                    @foreach (var certification in Certifications.OrderBy(x => x.SortOrder))
                    {
                        <div class="background-admin__item">

                            <div class="background-admin__item-content">
                                <strong>@certification.Title</strong>
                                <span>@certification.Issuer</span>
                            </div>

                            <div class="background-admin__actions">

                                <button type="button"
                                        class="admin-text-button"
                                        @onclick="() => EditCertification(certification)">
                                    Edit
                                </button>

                                <button type="button"
                                        class="admin-text-button admin-text-button--danger"
                                        @onclick="() => DeleteCertification(certification)">
                                    Delete
                                </button>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</section>

@code {
    [Parameter, EditorRequired]
    public List<Education> Education { get; set; } = [];

    [Parameter, EditorRequired]
    public List<Language> Languages { get; set; } = [];

    [Parameter, EditorRequired]
    public List<Certification> Certifications { get; set; } = [];

    private Education? editingEducation;
    private Education? originalEducation;
    private bool isAddingEducation;
    private bool scrollToEducationEditor;

    private Language? editingLanguage;
    private Language? originalLanguage;
    private bool isAddingLanguage;
    private bool scrollToLanguageEditor;

    private Certification? editingCertification;
    private Certification? originalCertification;
    private bool isAddingCertification;
    private bool scrollToCertificationEditor;

    private void AddEducation()
    {
        originalEducation = null;

        editingEducation = new Education
        {
            StartYear = DateTime.Today.Year,
            EndYear = DateTime.Today.Year,
            SortOrder = Education.Count + 1
        };

        isAddingEducation = true;
        scrollToEducationEditor = true;
    }

    private void EditEducation(Education education)
    {
        originalEducation = education;

        editingEducation = new Education
        {
            School = education.School,
            Program = education.Program,
            StartYear = education.StartYear,
            EndYear = education.EndYear,
            SortOrder = education.SortOrder
        };

        isAddingEducation = false;
        scrollToEducationEditor = true;
    }

    private void CancelEducationEdit()
    {
        editingEducation = null;
        originalEducation = null;
        isAddingEducation = false;
    }

    private void ApplyEducation()
    {
        if (editingEducation is null)
            return;

        if (isAddingEducation)
        {
            Education.Add(editingEducation);
        }
        else if (originalEducation is not null)
        {
            originalEducation.School = editingEducation.School;
            originalEducation.Program = editingEducation.Program;
            originalEducation.StartYear = editingEducation.StartYear;
            originalEducation.EndYear = editingEducation.EndYear;
            originalEducation.SortOrder = editingEducation.SortOrder;
        }

        editingEducation = null;
        originalEducation = null;
        isAddingEducation = false;
    }

    private void DeleteEducation(Education education)
    {
        Education.Remove(education);
        ReorderEducation();

        if (ReferenceEquals(originalEducation, education))
        {
            editingEducation = null;
            originalEducation = null;
            isAddingEducation = false;
        }
    }

    private void MoveEducationUp(Education education)
    {
        var ordered = Education.OrderBy(x => x.SortOrder).ToList();
        var index = ordered.IndexOf(education);

        if (index <= 0)
            return;

        var previous = ordered[index - 1];

        (education.SortOrder, previous.SortOrder) =
            (previous.SortOrder, education.SortOrder);
    }

    private void MoveEducationDown(Education education)
    {
        var ordered = Education.OrderBy(x => x.SortOrder).ToList();
        var index = ordered.IndexOf(education);

        if (index < 0 || index >= ordered.Count - 1)
            return;

        var next = ordered[index + 1];

        (education.SortOrder, next.SortOrder) =
            (next.SortOrder, education.SortOrder);
    }

    private void ReorderEducation()
    {
        var ordered = Education
            .OrderBy(x => x.SortOrder)
            .ToList();

        for (var i = 0; i < ordered.Count; i++)
        {
            ordered[i].SortOrder = i + 1;
        }
    }

    private void AddLanguage()
    {
        originalLanguage = null;

        editingLanguage = new Language
        {
            SortOrder = Languages.Count + 1
        };

        isAddingLanguage = true;
        scrollToLanguageEditor = true;
    }

    private void EditLanguage(Language language)
    {
        originalLanguage = language;

        editingLanguage = new Language
        {
            Name = language.Name,
            Proficiency = language.Proficiency,
            SortOrder = language.SortOrder
        };

        isAddingLanguage = false;
        scrollToLanguageEditor = true;
    }

    private void CancelLanguageEdit()
    {
        editingLanguage = null;
        originalLanguage = null;
        isAddingLanguage = false;
    }

    private void ApplyLanguage()
    {
        if (editingLanguage is null)
            return;

        if (isAddingLanguage)
        {
            Languages.Add(editingLanguage);
        }
        else if (originalLanguage is not null)
        {
            originalLanguage.Name = editingLanguage.Name;
            originalLanguage.Proficiency = editingLanguage.Proficiency;
            originalLanguage.SortOrder = editingLanguage.SortOrder;
        }

        editingLanguage = null;
        originalLanguage = null;
        isAddingLanguage = false;
    }

    private void DeleteLanguage(Language language)
    {
        Languages.Remove(language);
        ReorderLanguages();

        if (ReferenceEquals(originalLanguage, language))
        {
            editingLanguage = null;
            originalLanguage = null;
            isAddingLanguage = false;
        }
    }

    private void MoveLanguageUp(Language language)
    {
        var ordered = Languages.OrderBy(x => x.SortOrder).ToList();
        var index = ordered.IndexOf(language);

        if (index <= 0)
            return;

        var previous = ordered[index - 1];

        (language.SortOrder, previous.SortOrder) =
            (previous.SortOrder, language.SortOrder);
    }

    private void MoveLanguageDown(Language language)
    {
        var ordered = Languages.OrderBy(x => x.SortOrder).ToList();
        var index = ordered.IndexOf(language);

        if (index < 0 || index >= ordered.Count - 1)
            return;

        var next = ordered[index + 1];

        (language.SortOrder, next.SortOrder) =
            (next.SortOrder, language.SortOrder);
    }

    private void ReorderLanguages()
    {
        var ordered = Languages
            .OrderBy(x => x.SortOrder)
            .ToList();

        for (var i = 0; i < ordered.Count; i++)
        {
            ordered[i].SortOrder = i + 1;
        }
    }

    private void AddCertification()
    {
        originalCertification = null;

        editingCertification = new Certification
        {
            SortOrder = Certifications.Count + 1
        };

        isAddingCertification = true;
        scrollToCertificationEditor = true;
    }

    private void EditCertification(Certification certification)
    {
        originalCertification = certification;

        editingCertification = new Certification
        {
            Id = certification.Id,
            Title = certification.Title,
            Issuer = certification.Issuer,
            Description = certification.Description,
            FileUrl = certification.FileUrl,
            SortOrder = certification.SortOrder
        };

        isAddingCertification = false;
        scrollToCertificationEditor = true;
    }

    private void CancelCertificationEdit()
    {
        editingCertification = null;
        originalCertification = null;
        isAddingCertification = false;
    }

    private void ApplyCertification()
    {
        if (editingCertification is null)
            return;

        if (isAddingCertification)
        {
            Certifications.Add(editingCertification);
        }
        else if (originalCertification is not null)
        {
            originalCertification.Title = editingCertification.Title;
            originalCertification.Issuer = editingCertification.Issuer;
            originalCertification.Description = editingCertification.Description;
            originalCertification.FileUrl = editingCertification.FileUrl;
            originalCertification.SortOrder = editingCertification.SortOrder;
        }

        editingCertification = null;
        originalCertification = null;
        isAddingCertification = false;
    }

    private void DeleteCertification(Certification certification)
    {
        Certifications.Remove(certification);
        ReorderCertifications();

        if (ReferenceEquals(originalCertification, certification))
        {
            editingCertification = null;
            originalCertification = null;
            isAddingCertification = false;
        }
    }

    private void ReorderCertifications()
    {
        var ordered = Certifications
            .OrderBy(x => x.SortOrder)
            .ToList();

        for (var i = 0; i < ordered.Count; i++)
        {
            ordered[i].SortOrder = i + 1;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollToEducationEditor)
        {
            scrollToEducationEditor = false;

            var currentPage = Navigation.Uri.Split('#')[0];

            Navigation.NavigateTo($"{currentPage}#education-editor");
        }

        if (scrollToLanguageEditor)
        {
            scrollToLanguageEditor = false;

            var currentPage = Navigation.Uri.Split('#')[0];

            Navigation.NavigateTo($"{currentPage}#language-editor");
        }

        if (scrollToCertificationEditor)
        {
            scrollToCertificationEditor = false;

            var currentPage = Navigation.Uri.Split('#')[0];

            Navigation.NavigateTo($"{currentPage}#certification-editor");
        }

        return Task.CompletedTask;
    }
}