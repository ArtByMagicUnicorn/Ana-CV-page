@using Ana_CV_page.Models
@using System.Text.Encodings.Web
@using System.Text.RegularExpressions

@if (Data.IsVisible)
{
    <section id="beyond" class="beyond">

        <div class="beyond__header">
            <p class="eyebrow">Beyond the numbers</p>

            <h2>
                There's more to me than
                <span>spreadsheets and systems.</span>
            </h2>
        </div>

        <div class="beyond__grid">

            <div class="beyond__text">

                @FormatText(Data.Text)

                <div class="beyond__values">
                    <span>Curiosity</span>
                    <span>People</span>
                    <span>Learning</span>
                    <span>Growth</span>
                </div>

            </div>

            <div class="beyond__visual">

                @if (!string.IsNullOrWhiteSpace(Data.ImageUrl))
                {
                    <img src="@Data.ImageUrl"
                    alt="Ana outside of work"
                    class="beyond__image" />
                }
                else
                {
                    <div class="beyond__image-placeholder">
                        <span>Personal photo</span>
                    </div>
                }

            </div>

        </div>

    </section>
}

@code {
    [Parameter]
    public string? ImageUrl { get; set; }

    [Parameter, EditorRequired]
    public BeyondTheNumbersData Data { get; set; } = new();

    private MarkupString FormatText(string? text)
    {
        var encoded = HtmlEncoder.Default.Encode(text ?? string.Empty);

        encoded = Regex.Replace(
            encoded,
            @"\*\*(.+?)\*\*",
            "<strong>$1</strong>");

        encoded = Regex.Replace(
            encoded,
            @"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)",
            "<em>$1</em>");

        return new MarkupString(encoded);
    }
}