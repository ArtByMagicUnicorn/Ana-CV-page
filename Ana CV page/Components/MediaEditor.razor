@using Ana_CV_page.Models
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@inject HttpClient Http

<section id="media" class="admin-section">
    <div class="admin-section__heading">
        <span class="admin-section__number">06</span>
        <div>
            <h2>Media</h2>
            <p>Manage profile image, Beyond the Numbers image and intro video.</p>
        </div>
    </div>

    <div class="admin-form">
        <div class="admin-field admin-field--full">
            <label>Profile image</label>

            <input type="text" @bind="Profile.ProfileImageUrl" />

            <InputFile OnChange="OnProfileImageSelected"
                       accept=".png,.jpg,.jpeg,.webp" />

            <button type="button"
                    class="admin-button"
                    @onclick="UploadProfileImageAsync"
                    disabled="@(selectedProfileImage is null || isUploadingProfileImage)">
                @(isUploadingProfileImage ? "Uploading..." : "Upload image")
            </button>

            @if (!string.IsNullOrWhiteSpace(profileUploadMessage))
            {
                <small class="admin-field__hint">
                    @profileUploadMessage
                </small>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Profile.ProfileImageUrl))
        {
            <div class="media-preview">
                <span class="media-preview__label">Profile image preview</span>
                <img src="@Profile.ProfileImageUrl"
                     alt="Profile image preview"
                     class="media-preview__profile" />
            </div>
        }

        <div class="admin-field admin-field--full">
            <label>Beyond the Numbers image</label>
            <input type="text" @bind="BeyondTheNumbers.ImageUrl" />
            <small class="admin-field__hint">
                Image upload will be available when storage is connected.
            </small>
        </div>

        <InputFile OnChange="OnBeyondImageSelected"
                   accept=".png,.jpg,.jpeg,.webp" />

        <button type="button"
                class="admin-button"
                @onclick="UploadBeyondImageAsync"
                disabled="@(selectedBeyondImage is null || isUploadingBeyondImage)">
            @(isUploadingBeyondImage ? "Uploading..." : "Upload image")
        </button>

        @if (!string.IsNullOrWhiteSpace(beyondUploadMessage))
        {
            <small class="admin-field__hint">
                @beyondUploadMessage
            </small>
        }

        @if (!string.IsNullOrWhiteSpace(BeyondTheNumbers.ImageUrl))
        {
            <div class="media-preview">
                <span class="media-preview__label">Beyond the Numbers preview</span>
                <img src="@BeyondTheNumbers.ImageUrl"
                     alt="Beyond the Numbers image preview"
                     class="media-preview__beyond" />
            </div>
        }

        <div class="admin-field admin-field--full">
            <label>Intro video URL</label>
            <input type="text" @bind="Profile.IntroVideoUrl" />
            <small class="admin-field__hint">
                Paste a YouTube link to show the video on the public site.
            </small>
        </div>

        @{
            var videoId = GetYouTubeVideoId(Profile.IntroVideoUrl);
        }

        @if (!string.IsNullOrWhiteSpace(videoId))
        {
            <div class="media-preview">
                <span class="media-preview__label">Intro video preview</span>

                <div class="media-preview__video">
                    <iframe src="@($"https://www.youtube-nocookie.com/embed/{videoId}")"
                            title="Ana Gheorghe intro video preview"
                            loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen>
                    </iframe>
                </div>
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public Profile Profile { get; set; } = new();

    [Parameter, EditorRequired]
    public BeyondTheNumbersData BeyondTheNumbers { get; set; } = new();
    private IBrowserFile? selectedProfileImage;
    private bool isUploadingProfileImage;
    private string? profileUploadMessage;
    private IBrowserFile? selectedBeyondImage;
    private bool isUploadingBeyondImage;
    private string? beyondUploadMessage;

    private void OnProfileImageSelected(InputFileChangeEventArgs e)
    {
        selectedProfileImage = e.File;
        profileUploadMessage = null;
    }

    private async Task UploadProfileImageAsync()
    {
        if (selectedProfileImage is null)
            return;

        try
        {
            isUploadingProfileImage = true;
            profileUploadMessage = "Uploading...";

            await using var stream =
                selectedProfileImage.OpenReadStream(5 * 1024 * 1024);

            using var fileContent = new StreamContent(stream);

            using var form = new MultipartFormDataContent();
            form.Add(
                fileContent,
                "file",
                selectedProfileImage.Name);

            var response = await Http.PostAsync(
                "api/media/profile-image",
                form);

            response.EnsureSuccessStatusCode();

            var result =
                await response.Content.ReadFromJsonAsync<MediaUploadResponse>();

            if (string.IsNullOrWhiteSpace(result?.Url))
            {
                profileUploadMessage = "Upload failed.";
                return;
            }

            Profile.ProfileImageUrl = result.Url;
            profileUploadMessage = "Uploaded ✓";
            selectedProfileImage = null;
        }
        catch
        {
            profileUploadMessage = "Upload failed.";
        }
        finally
        {
            isUploadingProfileImage = false;
        }
    }

    private void OnBeyondImageSelected(InputFileChangeEventArgs e)
    {
        selectedBeyondImage = e.File;
        beyondUploadMessage = null;
    }

    private async Task UploadBeyondImageAsync()
    {
        if (selectedBeyondImage is null)
            return;

        try
        {
            isUploadingBeyondImage = true;
            beyondUploadMessage = "Uploading...";

            await using var stream =
                selectedBeyondImage.OpenReadStream(5 * 1024 * 1024);

            using var fileContent = new StreamContent(stream);

            using var form = new MultipartFormDataContent();
            form.Add(fileContent, "file", selectedBeyondImage.Name);

            var response = await Http.PostAsync(
                "api/media/beyond-image",
                form);

            response.EnsureSuccessStatusCode();

            var result =
                await response.Content.ReadFromJsonAsync<MediaUploadResponse>();

            if (string.IsNullOrWhiteSpace(result?.Url))
            {
                beyondUploadMessage = "Upload failed.";
                return;
            }

            BeyondTheNumbers.ImageUrl = result.Url;
            beyondUploadMessage = "Uploaded ✓";
            selectedBeyondImage = null;
        }
        catch
        {
            beyondUploadMessage = "Upload failed.";
        }
        finally
        {
            isUploadingBeyondImage = false;
        }
    }

    private sealed class MediaUploadResponse
    {
        public string Url { get; set; } = string.Empty;
    }

    private string? GetYouTubeVideoId(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return null;

        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
            return null;

        if (uri.Host.Contains("youtu.be"))
            return uri.AbsolutePath.Trim('/');

        if (uri.Host.Contains("youtube.com") &&
(uri.AbsolutePath.StartsWith("/shorts/") ||
 uri.AbsolutePath.StartsWith("/embed/")))
        {
            return uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries)
                                   .LastOrDefault();
        }

        if (uri.Host.Contains("youtube.com"))
        {
            foreach (var part in uri.Query.TrimStart('?').Split('&'))
            {
                var pair = part.Split('=', 2);

                if (pair.Length == 2 && pair[0] == "v")
                    return Uri.UnescapeDataString(pair[1]);
            }
        }

        return null;
    }
}